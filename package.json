{
  "name": "mark-rathbone-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Mark Rathbone's portfolio and CV-as-code",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "predev": "npm run generate:glass",
    "dev": "vite",
    "generate:cv": "node scripts/generate-cv.mjs",
    "generate:glass": "node scripts/generate-glass.mjs",
    "build": "npm run generate:cv && npm run generate:glass && vite build",
    "preview": "vite preview",
    "check": "node scripts/validate-cv.mjs && npm run build"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer": "^25.11.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "puppeteer@25.11.0": true
  }
}
